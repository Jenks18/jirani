# Jirani - environment variables. Copy to .env.local; never commit real values.

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# Meta for Developers -> your app -> WhatsApp -> API Setup / App settings
WHATSAPP_ACCESS_TOKEN=            # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=         # Phone number ID (not the phone number itself)
WHATSAPP_VERIFY_TOKEN=            # any random string; must match the webhook config in Meta
WHATSAPP_APP_SECRET=              # App settings -> Basic -> App secret (webhook signature check)
# WHATSAPP_GRAPH_VERSION=v23.0

# --- AI ----------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Database ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never prefix with NEXT_PUBLIC_. Required once migration 20260101 has locked the tables.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy fallback only

# --- Maps --------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://jirani.the625movement.com
NEXT_PUBLIC_MAPS_URL=https://maps.the625movement.com
# Guards /api/store-report and the detailed /api/status output
ADMIN_API_TOKEN=

SESSION_SECRET=
CRON_SECRET=
